# =====================================================================
# HostelHub backend configuration
# Copy this file to ".env" (same folder) and fill in YOUR values.
# The real .env is listed in .gitignore and must never be committed.
# The browser never sees any of these values: only the backend reads them.
# =====================================================================

# Port the web app runs on -> open http://localhost:3000
PORT=3000

# --- Oracle (schema created by database/01_create_user.sql) ---------
ORACLE_USER=hostelhub
ORACLE_PASSWORD=change_me
# host:port/service_name  (23ai Free -> FREEPDB1, 21c XE -> XEPDB1)
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# --- MongoDB (complaints module) ------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=hostelhub

# --- Login sessions -------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# How long a login lasts
JWT_EXPIRES_IN=8h
